# build output
obj/
__pycache__/
*.pyc

# desktop test builds
*PC.exe

# VestaHome deploy state
VestaHome/VestaHome/*.log
VestaHome/VestaHome/apps.txt
VestaHome/VestaHome/VestaHome.ini
VestaHome/VestaHome/*.tmp
VestaHome/VestaHome/*.nmea
VestaHome/VestaHome/speedcam/*

# G3patch generated / large
G3patch/ghidra/
G3patch/out/
G3patch/skin-vesta/
G3patch/*.log
G3patch/orig/

# installer build artifacts
G3patch/native/payload.bin
Install/VestaInstall.exe
VestaLaunch/VestaLaunch/*.log

# skin: generated reference renders from the .ai
skin/_ai/

# SPIPower proxy: generated + build artifacts
SPIPower/native/thunks.s
SPIPower/native/spipower.def
SPIPower/native/g_proxy.h
SPIPower/out/
SPIPower/ghidra/

# the rescue .upg carries vendor DLL bytes (same policy as G3patch/orig/):
# rebuild it from MAIN/ with SPIPower/tools/make_rescue.py
SPIPower/rescue/SwDnl.upg
# the drill package carries no vendor bytes (one generated text marker), so it is
# committed together with its cfg; only the ARM build output is kept out:
SPIPower/rescue/drill/*.exe

# LaunchInstall build artifacts
LaunchInstall/native/payload.bin
LaunchInstall/LaunchInstall/*.log

# GstProbe: log and generated settings on the device
GstProbe/GstProbe/*.log
GstProbe/GstProbe/GstProbe.txt

# VestaRescue build output
Rescue/out/
