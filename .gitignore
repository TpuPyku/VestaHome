# installer build artifacts
G3patch/native/payload.bin
Install/VestaInstall.exe
VestaLaunch/VestaLaunch/*.log

# skin: generated reference renders from the .ai
skin/_ai/

# SPIPower proxy: generated + build artifacts
SPIPower/native/thunks.s
SPIPower/native/spipower.def
SPIPower/native/g_proxy.h
SPIPower/bt/thunks.s
SPIPower/bt/flc.def
SPIPower/bt/g_btproxy.h
SPIPower/out/*
# the proxies themselves are kept: the installer packs them (fingerprints.h holds their MD5) and builds elsewhere need them
!SPIPower/out/SPIPowerMgr.dll
!SPIPower/out/FLC_BLUETOOTH_SDK.dll
SPIPower/ghidra/

# the rescue .upg carries vendor DLL bytes (same policy as G3patch/orig/):
# rebuild it from MAIN/ with SPIPower/tools/make_rescue.py
SPIPower/rescue/SwDnl.upg
# the drill package carries no vendor bytes (one generated text marker), so it is
# committed together with its cfg; only the ARM build output is kept out:
SPIPower/rescue/drill/*.exe

# LaunchInstall build artifacts
LaunchInstall/native/payload.bin
LaunchInstall/LaunchInstall/*.log

# GstProbe: log and generated settings on the device
GstProbe/GstProbe/*.log
GstProbe/GstProbe/GstProbe.txt

# VestaRescue build output
Rescue/out/
SPIPower/install/vh_payload.bin
VestaHome/VestaHome/TestMedia/
# G3patch was moved out of the repo 2026-10-17 (G3Skin\G3patch, MAIN\G3NavHMI_ghidra): never add it back
G3patch/

# the user guide's screens (tools/make_shots.py, made again on demand)
docs/shots/
# the PC build: the user widgets' answers in "RAM" (Temp\VestaWidgets beside the exe)
VestaHome/VestaHome/Temp/

# add-ons put next to the PC build for testing (VestaCore/plugins/*)

# the head unit check sheets: working papers, kept locally only (the user 2026-10-31)
docs/checklist-*

# our Ghidra scripts for the firmware study: kept locally only (the user 2026-10-31)
SPIPower/ghidra_scripts/
