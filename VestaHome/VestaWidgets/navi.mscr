# VestaHome widget "Навигация": every 5 s looks whether CityGuide runs; navi.txt in RAM (\Temp\VestaWidgets,
# no card wear), written only when it changes.
# VestaHome starts it once (start= in navi.ini) and only reads navi.txt.
ErrorLevel ("off")
MkDir ("\Temp\VestaWidgets")
Data = "\Temp\VestaWidgets\navi.txt"
Was = -1
While (1)
    Now = ProcExists("CityGuideCE.exe")
    If (Now <> Was)
        Was = Now
        If (Now)
            WriteFile (Data, "text=CityGuide работает^NL^text2=нажмите, чтобы открыть^NL^state=ok^NL^")
        Else
            WriteFile (Data, "text=CityGuide не запущен^NL^text2=нажмите, чтобы запустить^NL^state=warn^NL^")
        EndIf
    EndIf
    Sleep (5000)
EndWhile
