# Auto detect text files and perform LF normalization
* text=auto
# boot-updater artifacts must keep their exact bytes (SwDnl parses the .cfg as raw
# ANSI tokens and the .upg is a binary package)
SPIPower/rescue/*.cfg -text
SPIPower/rescue/drill/*.cfg -text
SPIPower/rescue/drill/*.upg -text
# the installer's generated fingerprint table keeps exact CRLF so that
# "tools/gen_fingerprints.py --check" can compare it byte-for-byte after a fresh clone
SPIPower/install/fingerprints.h -text
